{
  "name": "pulseops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:monitor": "node --env-file=.env.local scripts/monitor-worker.mjs",
    "dev:email": "EMAIL_MODE=smtp node --env-file=.env.local scripts/notification-worker.mjs --watch",
    "dev:all": "concurrently --kill-others-on-fail --names web,monitor,email \"npm run dev:web\" \"npm run dev:monitor\" \"npm run dev:email\"",
    "test:api": "node --test scripts/api-smoke.test.mjs",
    "start:monitor": "node scripts/monitor-worker.mjs",
    "start:email": "node scripts/notification-worker.mjs --watch",
    "start:web": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@netlify/functions": "^6.1.1",
    "bullmq": "^6.7.8",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
